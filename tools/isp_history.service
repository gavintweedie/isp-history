[Unit]
Description=ISP History family tree (Flask)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/gav/dev/isp_history
ExecStart=/home/gav/.local/bin/gunicorn -w 4 -b 127.0.0.1:4004 --chdir /home/gav/dev/isp_history/app server:app
Restart=always
RestartSec=3

# Optional overrides (data dir, prefix, port) can go in an EnvironmentFile;
# the defaults in app/config.py are fine.
Environment=ISP_HISTORY_PORT=4004
Environment=ISP_HISTORY_BASE_PATH=

[Install]
WantedBy=default.target
